{
  "name": "payload-inplace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs run build --filter=payload-inplace",
    "typecheck": "node scripts/run-turbo.mjs run typecheck",
    "lint": "pnpm lint:oxlint && pnpm lint:source && node scripts/check-boundaries.mjs && node scripts/check-lint-contracts.mjs",
    "test:unit": "node scripts/run-turbo.mjs run test:unit",
    "test:int": "vitest run --project native-integration",
    "test:int:postgres": "VE_DATABASE=postgres vitest run --project native-integration",
    "test:e2e": "playwright test",
    "test:e2e:prod": "VE_PRODUCTION=1 playwright test",
    "dev": "node apps/demo/start-server.mjs",
    "dev:generate-importmap": "VE_DATABASE=postgres PAYLOAD_CONFIG_PATH=apps/demo/payload.config.ts payload generate:importmap",
    "pack:check": "node scripts/check-package.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "release:check": "node scripts/validate-release.mjs",
    "test:graph": "node scripts/check-production-graph.mjs",
    "test:postgres": "node scripts/postgres-test.mjs",
    "build:css": "tailwindcss -i packages/payload-inplace/src/admin/tailwind.css -o packages/payload-inplace/src/admin/styles.css --minify && tailwindcss -i packages/payload-inplace/src/preview/tailwind.css -o packages/payload-inplace/src/preview/styles.css --minify && tailwindcss -i packages/payload-inplace/src/launcher/tailwind.css -o packages/payload-inplace/src/launcher/styles.css --minify && tailwindcss -i packages/payload-inplace/src/frontend/inline.tailwind.css -o packages/payload-inplace/src/frontend/inline.styles.css --minify && node scripts/build-frontend-styles.mjs",
    "test:installed-consumer": "node scripts/test-installed-consumer.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "build:package": "pnpm build:css && tsdown && node scripts/copy-package-assets.mjs",
    "lint:source": "eslint packages apps scripts",
    "lint:oxlint": "oxlint packages apps scripts",
    "build:demo:css": "tailwindcss -i apps/demo/tailwind.css -o apps/demo/styles.css --minify && tailwindcss -i apps/demo/protected.tailwind.css -o apps/demo/protected.styles.css --minify",
    "test:package": "publint packages/payload-inplace && pnpm pack:check && pnpm test:consumer && pnpm test:package-types",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --project 'unit:*' --project components --coverage --reporter=default --reporter=json --outputFile=test-results/unit-domains.json",
    "test:domain": "vitest run --project",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check",
    "test:feature-budgets": "node scripts/check-feature-budgets.mjs",
    "test:package-types": "node scripts/check-package-types.mjs",
    "test:workspace": "node scripts/check-workspace-cache.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tsdown/css": "0.22.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.1",
    "graphql": "^16.12.0",
    "happy-dom": "21.0.4",
    "mongodb-memory-server": "10.1.4",
    "next": "16.4.2",
    "oxlint": "1.91.0",
    "payload": "3.91.0",
    "pg": "^8.16.3",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.6.2",
    "publint": "0.3.25",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.3",
    "tsx": "4.21.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.0.18",
    "lexical": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/history": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@lexical/selection": "0.50.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ]
  }
}
