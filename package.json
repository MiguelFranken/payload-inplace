{
  "name": "payload-inplace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/run-turbo.mjs run build --filter=payload-inplace",
    "typecheck": "node scripts/run-turbo.mjs run typecheck",
    "lint": "pnpm lint:oxlint && pnpm lint:source && node scripts/check-boundaries.mjs && node scripts/check-lint-contracts.mjs",
    "test:unit": "node scripts/run-turbo.mjs run test:unit",
    "test:int": "vitest run --project native-integration",
    "test:int:postgres": "VE_DATABASE=postgres vitest run --project native-integration",
    "test:e2e": "pnpm --filter @payload-inplace/acceptance test:e2e",
    "test:e2e:prod": "VE_PRODUCTION=1 pnpm test:e2e",
    "dev": "node apps/demo/start-server.mjs",
    "dev:generate-importmap": "pnpm --filter @payload-inplace/demo generate:importmap",
    "pack:check": "node scripts/check-package.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "release:check": "node scripts/validate-release.mjs",
    "test:graph": "node scripts/check-production-graph.mjs",
    "test:postgres": "node scripts/postgres-test.mjs",
    "build:css": "pnpm --filter payload-inplace build:css",
    "test:installed-consumer": "node scripts/test-installed-consumer.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "build:package": "pnpm --filter payload-inplace build",
    "lint:source": "eslint packages apps scripts tests",
    "lint:oxlint": "oxlint packages apps scripts tests",
    "build:demo:css": "pnpm --filter @payload-inplace/demo build:css",
    "test:package": "pnpm --filter payload-inplace exec publint && pnpm pack:check && pnpm test:consumer && pnpm test:package-types",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --project 'unit:*' --project components --coverage --reporter=default --reporter=json --outputFile=test-results/unit-domains.json",
    "test:domain": "vitest run --project",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check && node scripts/check-doc-links.mjs",
    "test:feature-budgets": "node scripts/check-feature-budgets.mjs",
    "test:package-types": "node scripts/check-package-types.mjs",
    "test:workspace": "node scripts/check-workspace-cache.mjs",
    "docs:media": "VE_PORT=3167 VE_PRODUCTION=1 VE_NEXT_DIST_DIR=.next-docs-media pnpm --filter @payload-inplace/acceptance docs:media",
    "storybook": "pnpm --filter @payload-inplace/storybook dev",
    "build:storybook": "node scripts/run-turbo.mjs run build --filter=@payload-inplace/storybook",
    "test:storybook": "pnpm test:stories && pnpm --filter @payload-inplace/acceptance test:storybook",
    "test:stories": "pnpm --filter @payload-inplace/storybook test:stories"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.1",
    "oxlint": "1.91.0",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ]
  }
}
