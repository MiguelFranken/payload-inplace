{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@internal/*": ["./packages/payload-inplace/src/*"],
      "@payload-config": [
        "./apps/demo/payload.config.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/demo/**/*.ts",
    "apps/demo/**/*.tsx",
    "tests/**/*.ts",
    "*.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/.next*/**"
  ]
}
